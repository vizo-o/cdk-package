{
    "name": "@vizo-o/cdk-package",
    "version": "0.1.28",
    "exports": {
        "./constructs": {
            "types": "./dist/lib/constructs/index.d.ts",
            "default": "./dist/lib/constructs/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "cdk": "cdk",
        "lint": "oxlint test lib -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json",
        "lint:fix": "oxlint test lib -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json --fix",
        "type-check": "tsc --noEmit",
        "audit:high": "npm audit --audit-level=high",
        "pre-release": "node scripts/pre-release.mjs",
        "release": "release-it",
        "release:ci": "npm run pre-release && release-it --ci",
        "postinstall": "node scripts/patch-aws-cdk-nested-minimatch.mjs",
        "typecheck": "tsc --noEmit",
        "typecheck:native": "tsgo --noEmit 2>/dev/null || tsc --noEmit"
    },
    "peerDependencies": {
        "aws-cdk-lib": "^2.259.0",
        "constructs": "^10.5.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "22.10.1",
        "@typescript/native-preview": "^7.0.0-dev",
        "@vizo-o/dev-tools": "^1.0.64",
        "aws-cdk": "2.1127.0",
        "aws-cdk-lib": "2.261.0",
        "brace-expansion": "5.0.9",
        "constructs": "10.5.0",
        "fast-uri": "4.1.2",
        "jest": "^29.7.0",
        "minimatch": "10.2.3",
        "oxlint": "^1.75.0",
        "prettier": "^3.4.2",
        "release-it": "^19.2.4",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.8.2"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
        "@aws-sdk/client-lambda": "^3.0.0",
        "@aws-sdk/client-secrets-manager": "^3.0.0",
        "@aws-sdk/client-ssm": "^3.0.0",
        "source-map-support": "^0.5.21"
    },
    "description": "CDK constructs and utilities for Vizo infrastructure",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vizo-o/cdk-package.git"
    },
    "author": "Gilaad Elstein",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/vizo-o/cdk-package/issues"
    },
    "homepage": "https://github.com/vizo-o/cdk-package#readme",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "overrides": {
        "lodash": ">=4.17.24",
        "brace-expansion": "5.0.9",
        "minimatch": "10.2.3",
        "fast-xml-parser": ">=5.8.0",
        "fast-xml-builder": ">=1.2.0",
        "fast-uri": "4.1.2",
        "braces": "3.0.3",
        "undici": ">=7.29.0 <8.0.0",
        "js-yaml": ">=5.2.2",
        "aws-cdk-lib": {
            "minimatch": "10.2.3",
            "brace-expansion": "5.0.9",
            "fast-uri": "4.1.2"
        }
    }
}
